# Spotify Web API credentials
# Get them from https://developer.spotify.com/dashboard
# Requires a Spotify PREMIUM account (Spotify's rule since Feb 2026).
#
# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" - it is in .gitignore.

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ---------------------------------------------------------------------------
# OPTIONAL: only needed for playlists longer than 100 songs.
#
# Spotify's public embed page shows just the first 100 tracks. To read past
# that you need a USER access token (Client Credentials stopped working for
# playlist contents in Spotify's February 2026 change).
#
# Get it from the app itself: Home -> "Playlist lebih dari 100 lagu? Hubungkan
# Spotify (opsional)" -> login -> paste the code. The app writes the refresh
# token here for you.
#
# With this set, private playlists also become readable.
# ---------------------------------------------------------------------------
SPOTIFY_REFRESH_TOKEN=
